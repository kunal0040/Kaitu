# Ignore list for Eagle, a PCB layout tool
git add .
git commit -m "Initialize Kaitu V1 core architecture and tracking rules"
git push origin main

# Backup files
*.s#?
*.b#?
*.l#?
*.b$?
*.s$?
*.l$?

# Eagle project file
# It contains a serial number and references to the file structure
# on your computer.
# comment the following line if you want to have your project file included.
eagle.epf
.vscode
data
voices
tests

# Autorouter files
*.pro
*.job
*.venv
*.env
*.coverage

__pycache__/
*.pyc
app_registry.py

